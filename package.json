{
  "name": "@laivikto/dsh-ssh-servers",
  "version": "1.7.0",
  "description": "SSH server manager for DeepSeek Harness: saved key/password connections, native key-file picker, live connection health, IPv4/IPv6 display, a task prompt copied to the clipboard, and remote file browsing.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "Laivikto",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ssh",
    "ssh-client",
    "remote",
    "server-management"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Laivikto/dsh-ssh-servers.git"
  },
  "bugs": {
    "url": "https://github.com/Laivikto/dsh-ssh-servers/issues"
  },
  "homepage": "https://github.com/Laivikto/dsh-ssh-servers#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-terminal",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:watch": "node --test --watch tests/*.test.mjs",
    "check": "node --check index.js && node --check client.js",
    "prepublishOnly": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
